generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIRECTEUR
  SECRETAIRE
}

enum Sexe {
  Masculin
  Feminin
}

model SchoolYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([active])
  @@index([name])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(SECRETAIRE)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([active])
  @@index([role])
}

model Permission {
  id      Int     @id @default(autoincrement())
  role    Role
  action  String
  allowed Boolean @default(false)

  @@unique([role, action])
  @@index([role])
}

model Student {
  id               Int      @id @default(autoincrement())
  matricule        String
  site             String   @default("Strelitzia School")

  // Année scolaire de l'étudiant.
  // IMPORTANT: pour Student, ton ancien code utilise déjà "anneeScolaire".
  anneeScolaire    String   @default("2025-2026")

  dateInscription  DateTime

  photoUrl         String?
  nom              String
  prenoms          String
  sexe             Sexe
  classe           String
  section          String

  contact          String?
  dateNaissance    DateTime?
  lieuNaissance    String?
  adresse          String?
  signeParticulier String?
  maladieAllergie  String?
  email            String?

  pereNom          String?
  pereTel          String?
  mereNom          String?
  mereTel          String?
  parentAdresse    String?

  tuteurNom        String?
  tuteurLien       String?
  tuteurTel        String?
  tuteurAdresse    String?

  niveau           String?
  fraisInscription String?
  fraisScolarite   String?

  activite         String?
  remarque         String?

  createdAt        DateTime @default(now())

  @@unique([matricule, anneeScolaire])
  @@index([anneeScolaire])
  @@index([classe])
  @@index([section])
  @@index([anneeScolaire, classe, section])
  @@index([anneeScolaire, createdAt])
  @@index([createdAt])
  @@index([nom])
  @@index([matricule])
}

model Level {
  id             Int         @id @default(autoincrement())
  name           String
  schoolYearName String      @default("2025-2026")
  createdAt      DateTime    @default(now())

  classes        ClassRoom[]

  @@unique([name, schoolYearName])
  @@index([schoolYearName])
  @@index([name])
}

model ClassRoom {
  id             Int      @id @default(autoincrement())
  name           String
  levelId        Int
  schoolYearName String   @default("2025-2026")
  createdAt      DateTime @default(now())

  level          Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  series         Serie[]

  @@unique([name, levelId, schoolYearName])
  @@index([levelId])
  @@index([schoolYearName])
  @@index([schoolYearName, name])
  @@index([name])
}

model Serie {
  id             Int       @id @default(autoincrement())
  name           String
  classRoomId    Int
  schoolYearName String    @default("2025-2026")
  createdAt      DateTime  @default(now())

  classRoom      ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)

  @@unique([name, classRoomId, schoolYearName])
  @@index([classRoomId])
  @@index([schoolYearName])
  @@index([schoolYearName, name])
  @@index([name])
}

model FeeModel {
  id             Int      @id @default(autoincrement())
  title          String
  classe         String
  schoolYearName String   @default("2025-2026")
  createdAt      DateTime @default(now())

  tariffs        FeeTariff[]

  @@unique([title, classe, schoolYearName])
  @@index([schoolYearName])
  @@index([classe])
  @@index([schoolYearName, classe])
}

model FeeTariff {
  id         Int      @id @default(autoincrement())
  feeModelId Int
  libelle    String
  code       String
  montant    Int
  createdAt  DateTime @default(now())

  feeModel   FeeModel @relation(fields: [feeModelId], references: [id], onDelete: Cascade)
  specials   FeeSpecialTariff[]

  @@index([feeModelId])
  @@index([code])
}

model FeeSpecialTariff {
  id          Int      @id @default(autoincrement())
  feeTariffId Int
  name        String
  amount      Int
  createdAt   DateTime @default(now())

  feeTariff   FeeTariff @relation(fields: [feeTariffId], references: [id], onDelete: Cascade)

  @@index([feeTariffId])
  @@index([name])
}

model TrainingFee {
  id             Int      @id @default(autoincrement())
  schoolYearName String   @default("2025-2026")
  site           String   @default("Strelitzia School")
  levelId        Int?
  classe         String
  feeModelId     Int?
  libelle        String
  code           String
  montant        Int
  createdAt      DateTime @default(now())

  @@index([schoolYearName])
  @@index([classe])
  @@index([code])
  @@index([feeModelId])
  @@index([schoolYearName, classe])
  @@index([schoolYearName, classe, code])
}

model StudentFee {
  id             Int      @id @default(autoincrement())
  studentId      Int
  trainingFeeId  Int
  schoolYearName String   @default("2025-2026")
  libelle        String
  code           String
  montantTotal   Int
  montantPaye    Int      @default(0)
  reste          Int
  status         String   @default("NON_PAYE")
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, trainingFeeId, schoolYearName])
  @@index([studentId])
  @@index([trainingFeeId])
  @@index([schoolYearName])
  @@index([schoolYearName, studentId])
  @@index([schoolYearName, status])
}

model StudentPayment {
  id             Int      @id @default(autoincrement())
  studentId      Int
  trainingFeeId  Int
  schoolYearName String   @default("2025-2026")
  montantTotal   Int
  montantPaye    Int
  reste          Int
  status         String   @default("PARTIEL")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studentId])
  @@index([trainingFeeId])
  @@index([schoolYearName])
  @@index([schoolYearName, studentId])
  @@index([schoolYearName, status])
  @@index([createdAt])
}

model Treasury {
  id             Int      @id @default(autoincrement())
  name           String
  type           String   @default("CAISSE")
  active         Boolean  @default(true)

  // Tsy optional intsony: caisse/trésorerie tsirairay dia an'ny année scolaire iray.
  schoolYearName String   @default("2025-2026")
  isPrincipal    Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  movements      TreasuryMovement[]

  // Anarana mitovy azo averina amin'ny année hafa.
  @@unique([name, schoolYearName])
  @@index([active])
  @@index([type])
  @@index([schoolYearName])
  @@index([schoolYearName, active])
  @@index([schoolYearName, isPrincipal])
}

model TreasuryMovement {
  id             Int      @id @default(autoincrement())
  treasuryId     Int
  movementType   String
  category       String
  amount         Int
  description    String?
  reference      String?
  studentId      Int?
  trainingFeeId  Int?
  studentFeeId   Int?

  // Tsy optional intsony: mouvement rehetra dia an'ny année scolaire iray.
  schoolYearName String   @default("2025-2026")

  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  treasury       Treasury @relation(fields: [treasuryId], references: [id], onDelete: Cascade)

  @@index([treasuryId])
  @@index([movementType])
  @@index([category])
  @@index([createdAt])
  @@index([schoolYearName])
  @@index([studentId])
  @@index([schoolYearName, treasuryId])
  @@index([schoolYearName, movementType])
  @@index([schoolYearName, category])
  @@index([schoolYearName, createdAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserRole {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  label       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions Permission[]

  @@index([active])
  @@index([name])

  @@map("UserRole")
}


enum Sexe {
  Masculin
  Feminin
}

model SchoolYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([active])
  @@index([name])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  // Ancien champ gardé pour compatibilité avec le code actuel (login/sidebar/reçus).
  role      String   @default("SECRETAIRE")

  // Nouveau rôle personnalisable créé par l’admin.
  roleId    Int?
  roleRef   UserRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([active])
  @@index([role])
  @@index([roleId])

  profilePhoto String?
  mustChangePassword Boolean @default(false)
}

model Permission {
  id      Int     @id @default(autoincrement())
  roleId  Int
  action  String
  allowed Boolean @default(false)

  role    UserRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, action])
  @@index([roleId])
  @@index([action])
}

model Student {
  id               Int      @id @default(autoincrement())
  matricule        String
  site             String   @default("Strelitzia School")
  siteId Int?
  siteRef Site? @relation(fields: [siteId], references: [id])


  // Année scolaire de l'étudiant.
  // IMPORTANT: pour Student, ton ancien code utilise déjà "anneeScolaire".
  anneeScolaire    String   @default("2025-2026")

  dateInscription  DateTime

  photoUrl         String?
  nom              String
  prenoms          String
  sexe             Sexe
  classe           String
  section          String

  contact          String?
  dateNaissance    DateTime?
  lieuNaissance    String?
  adresse          String?
  signeParticulier String?
  maladieAllergie  String?
  email            String?

  pereNom          String?
  pereTel          String?
  mereNom          String?
  mereTel          String?
  parentAdresse    String?

  tuteurNom        String?
  tuteurLien       String?
  tuteurTel        String?
  tuteurAdresse    String?

  niveau           String?
  fraisInscription String?
  fraisScolarite   String?

  activite         String?
  remarque         String?

  createdAt        DateTime @default(now())

  @@unique([matricule, anneeScolaire])
  @@index([anneeScolaire])
  @@index([classe])
  @@index([section])
  @@index([anneeScolaire, classe, section])
  @@index([anneeScolaire, createdAt])
  @@index([createdAt])
  @@index([nom])
  @@index([matricule])
}

model Level {
  id             Int      @id @default(autoincrement())

  siteId         Int?
  site           String?

  name           String
  schoolYearName String   @default("2025-2026")
  createdAt      DateTime @default(now())

  classes        ClassRoom[]

  @@unique([name, schoolYearName, siteId])
  @@index([siteId])
  @@index([schoolYearName])
  @@index([siteId, schoolYearName])
}

model ClassRoom {
  id             Int      @id @default(autoincrement())

  siteId         Int?
  site           String?

  name           String
  levelId        Int
  schoolYearName String   @default("2025-2026")
  createdAt      DateTime @default(now())

  level          Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  series         Serie[]

  @@unique([name, levelId, schoolYearName, siteId])
  @@index([siteId])
  @@index([levelId])
  @@index([schoolYearName])
  @@index([siteId, schoolYearName])
}

model Serie {
  id             Int      @id @default(autoincrement())

  siteId         Int?
  site           String?

  name           String
  classRoomId    Int
  schoolYearName String   @default("2025-2026")
  createdAt      DateTime @default(now())

  classRoom      ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)

  @@unique([name, classRoomId, schoolYearName, siteId])
  @@index([siteId])
  @@index([classRoomId])
  @@index([schoolYearName])
  @@index([siteId, schoolYearName])
}

model FeeModel {
  id             Int      @id @default(autoincrement())

  siteId         Int?
  site           String?

  title          String
  classe         String
  schoolYearName String

  createdAt      DateTime @default(now())

  tariffs        FeeTariff[]

  @@index([siteId])
  @@index([schoolYearName])
  @@index([siteId, schoolYearName])

  @@unique([title, classe, schoolYearName, siteId])
}

model FeeTariff {
  id         Int      @id @default(autoincrement())
  feeModelId Int
  libelle    String
  code       String
  montant    Int
  createdAt  DateTime @default(now())

  feeModel   FeeModel @relation(fields: [feeModelId], references: [id], onDelete: Cascade)
  specials   FeeSpecialTariff[]

  @@index([feeModelId])
  @@index([code])
}

model FeeSpecialTariff {
  id          Int      @id @default(autoincrement())
  feeTariffId Int
  name        String
  amount      Int
  createdAt   DateTime @default(now())

  feeTariff   FeeTariff @relation(fields: [feeTariffId], references: [id], onDelete: Cascade)

  @@index([feeTariffId])
  @@index([name])
}

model TrainingFee {
  id               Int      @id @default(autoincrement())

  siteId           Int?
  site             String   @default("Strelitzia School")

  schoolYearName   String   @default("2025-2026")

  levelId          Int?
  classe           String

  feeModelId       Int?

  libelle          String
  code             String
  montant          Int

  createdAt        DateTime @default(now())

  @@index([siteId])
  @@index([schoolYearName])
  @@index([classe])
  @@index([code])
  @@index([feeModelId])

  @@index([siteId, schoolYearName])
  @@index([schoolYearName, classe])
  @@index([schoolYearName, classe, code])
}
model StudentFee {
  id             Int      @id @default(autoincrement())
  studentId      Int
  trainingFeeId  Int
  schoolYearName String   @default("2025-2026")
  libelle        String
  code           String
  montantTotal   Int
  montantPaye    Int      @default(0)
  reste          Int
  status         String   @default("NON_PAYE")
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, trainingFeeId, schoolYearName])
  @@index([studentId])
  @@index([trainingFeeId])
  @@index([schoolYearName])
  @@index([schoolYearName, studentId])
  @@index([schoolYearName, status])
}

model StudentPayment {
  id             Int      @id @default(autoincrement())
  studentId      Int
  trainingFeeId  Int
  schoolYearName String   @default("2025-2026")
  montantTotal   Int
  montantPaye    Int
  reste          Int
  status         String   @default("PARTIEL")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studentId])
  @@index([trainingFeeId])
  @@index([schoolYearName])
  @@index([schoolYearName, studentId])
  @@index([schoolYearName, status])
  @@index([createdAt])
}

model Treasury {
  id     Int     @id @default(autoincrement())

  // MULTI SITE
  siteId Int?
  site   String?

  name   String
  type   String  @default("CAISSE")
  active Boolean @default(true)

  schoolYearName String

  isPrincipal Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements TreasuryMovement[]

  @@unique([name, schoolYearName, siteId])

  @@index([siteId])
  @@index([active])
  @@index([type])
  @@index([schoolYearName])
  @@index([isPrincipal])

  @@index([siteId, schoolYearName])
  @@index([siteId, active])
}

model TreasuryMovement {
  id Int @id @default(autoincrement())

  treasuryId Int

  // MULTI SITE
  siteId Int?
  site   String?

  movementType String
  category     String

  amount Int

  description String?
  reference   String?

  // =========================
  // AFFICHAGE TRÉSORERIE
  // =========================
  motif            String?
  libelle          String?

  modePaiement     String?
  paymentMode      String?

  studentName      String?
  studentMatricule String?
  studentClasse    String?
  studentSection   String?

  feeCode          String?
  feeLabel         String?

  source           String?
  sourceType       String?

  // =========================
  // LIENS MÉTIER
  // =========================
  studentId     Int?
  trainingFeeId Int?
  studentFeeId  Int?

  schoolYearName String @default("2025-2026")

  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  treasury Treasury @relation(fields: [treasuryId], references: [id], onDelete: Cascade)

  @@index([treasuryId])
  @@index([siteId])

  @@index([movementType])
  @@index([category])

  @@index([createdAt])
  @@index([schoolYearName])

  @@index([studentId])
  @@index([trainingFeeId])
  @@index([studentFeeId])

  @@index([studentName])
  @@index([studentMatricule])

  @@index([feeCode])
  @@index([feeLabel])

  @@index([schoolYearName, treasuryId])
  @@index([schoolYearName, movementType])
  @@index([schoolYearName, category])
  @@index([schoolYearName, createdAt])

  // MULTI SITE
  @@index([siteId, treasuryId])
  @@index([siteId, schoolYearName])
  @@index([siteId, schoolYearName, treasuryId])
  @@index([siteId, movementType])
  @@index([siteId, category])

  // Recherche rapide
  @@index([reference])
}

model Site {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students Student[]
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  DIRECTEUR
  SECRETAIRE
}

enum Sexe {
  Masculin
  Feminin
}

model SchoolYear {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([active])
  @@index([name])
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(SECRETAIRE)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([active])
  @@index([role])
}

model Permission {
  id      Int     @id @default(autoincrement())
  role    Role
  action  String
  allowed Boolean @default(false)

  @@unique([role, action])
  @@index([role])
}

model Student {
  id               Int      @id @default(autoincrement())
  matricule        String  
  site             String   @default("Strelitzia School")
  anneeScolaire    String   @default("2025-2026")
  dateInscription  DateTime

  photoUrl         String?
  nom              String
  prenoms          String
  sexe             Sexe
  classe           String
  section          String

  contact          String?
  dateNaissance    DateTime?
  lieuNaissance    String?
  adresse          String?
  signeParticulier String?
  maladieAllergie  String?
  email            String?

  pereNom          String?
  pereTel          String?
  mereNom          String?
  mereTel          String?
  parentAdresse    String?

  tuteurNom        String?
  tuteurLien       String?
  tuteurTel        String?
  tuteurAdresse    String?

  niveau           String?
  fraisInscription String?
  fraisScolarite   String?

  activite         String?
  remarque         String?

  createdAt        DateTime @default(now())

  @@index([anneeScolaire])
  @@index([classe])
  @@index([section])
  @@index([anneeScolaire, classe, section])
  @@index([createdAt])
  @@index([nom])
  @@index([matricule])
  @@unique([matricule, anneeScolaire])
}

model Level {
  id             Int         @id @default(autoincrement())
  name           String
  schoolYearName String
  createdAt      DateTime    @default(now())

  classes        ClassRoom[]

  @@unique([name, schoolYearName])
  @@index([schoolYearName])
  @@index([name])
}

model ClassRoom {
  id             Int      @id @default(autoincrement())
  name           String
  levelId        Int
  schoolYearName String
  createdAt      DateTime @default(now())

  level          Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  series         Serie[]

  @@unique([name, levelId, schoolYearName])
  @@index([levelId])
  @@index([schoolYearName])
  @@index([name])
}

model Serie {
  id             Int       @id @default(autoincrement())
  name           String
  classRoomId    Int
  schoolYearName String
  createdAt      DateTime  @default(now())

  classRoom      ClassRoom @relation(fields: [classRoomId], references: [id], onDelete: Cascade)

  @@unique([name, classRoomId, schoolYearName])
  @@index([classRoomId])
  @@index([schoolYearName])
  @@index([name])
}

model FeeModel {
  id             Int      @id @default(autoincrement())
  title          String
  classe         String
  schoolYearName String
  createdAt      DateTime @default(now())

  tariffs        FeeTariff[]

  @@index([schoolYearName])
  @@index([classe])
  @@unique([title, classe, schoolYearName])
}

model FeeTariff {
  id         Int      @id @default(autoincrement())
  feeModelId Int
  libelle    String
  code       String
  montant    Int
  createdAt  DateTime @default(now())

  feeModel   FeeModel @relation(fields: [feeModelId], references: [id], onDelete: Cascade)
  specials   FeeSpecialTariff[]

  @@index([feeModelId])
  @@index([code])
}

model FeeSpecialTariff {
  id          Int      @id @default(autoincrement())
  feeTariffId Int
  name        String
  amount      Int
  createdAt   DateTime @default(now())

  feeTariff   FeeTariff @relation(fields: [feeTariffId], references: [id], onDelete: Cascade)

  @@index([feeTariffId])
  @@index([name])
}
model TrainingFee {
  id             Int      @id @default(autoincrement())
  schoolYearName String
  site           String   @default("Strelitzia School")
  levelId        Int?
  classe         String
  feeModelId     Int?
  libelle        String
  code           String
  montant        Int
  createdAt      DateTime @default(now())

  @@index([schoolYearName])
  @@index([classe])
  @@index([code])
  @@index([feeModelId])
}

model StudentPayment {
  id             Int      @id @default(autoincrement())
  studentId      Int
  trainingFeeId  Int
  schoolYearName String
  montantTotal   Int
  montantPaye    Int
  reste          Int
  status         String   @default("PARTIEL")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
model StudentFee {
  id             Int      @id @default(autoincrement())
  studentId      Int
  trainingFeeId  Int
  schoolYearName String
  libelle        String
  code           String
  montantTotal   Int
  montantPaye    Int      @default(0)
  reste          Int
  status         String   @default("NON_PAYE")
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, trainingFeeId, schoolYearName])
}